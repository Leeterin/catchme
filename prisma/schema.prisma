// ============================================================
// CATCHME - Database Schema
// ------------------------------------------------------------
// 프라이버시 원칙: Event.title은 절대 다른 유저에게 노출되지 않는다.
// 매칭 로직은 오직 status(Busy/Available)만 참조한다.
// ============================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AvailabilityStatus {
  BUSY
  AVAILABLE
}

// ------------------------------------------------------------
// User (회원가입 시 생성되는 계정)
// ------------------------------------------------------------
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique // 아이디 (@username 형태로 검색/노출)
  name         String
  passwordHash String? // 소셜 로그인(카카오/네이버)으로 가입한 사람은 비밀번호가 없음

  // 소셜 로그인 연결 정보
  kakaoId String? @unique
  naverId String? @unique

  profileImageUrl String?
  phone           String?
  bio             String? // 자기소개

  // 리뷰용(커뮤니티) 프로필 - 실명으로 리뷰 달기 창피할 수 있어서 만든 별도 닉네임/사진.
  // 소식 탭/장소 태그 모아보기 등 "리뷰" 관련 화면에서만 쓰이고, 친구 목록/채팅/모임 같은 다른 화면은
  // 그대로 실명 프로필을 씀. 둘 다 설정 안 했으면(null) 실명/기존 프로필 사진으로 자동 대체됨.
  reviewNickname  String?
  reviewAvatarUrl String?

  // 커뮤니티 화면에서 "현위치"를 썼을 때 최근 위치를 저장해둠 (다른 사람이 "내 근처 친구"를 찾을 때 이 위치가 기준이 됨).
  // 명시적으로 "현위치"를 선택했을 때만 갱신됨 - 항상 추적되는 게 아님
  lastLat       Float?
  lastLon       Float?
  lastLocatedAt DateTime?
  locationSharing Boolean @default(false) // "위치 공유 동의"를 명시적으로 했는지 (좌표가 있어도 이게 꺼져있으면 근처 친구 추천 대상이 안 됨)

  // 공개/비공개 설정 - 친구에게 보일지 여부
  phonePublic Boolean @default(false)
  emailPublic Boolean @default(false) // 새로 가입하면 이메일은 기본 비공개 (전화번호와 같게)

  // 관리자 제재 - 정지되면 로그인 자체가 막힘 (관리자 페이지에서만 설정/해제 가능)
  isSuspended     Boolean   @default(false)
  suspendedReason String?
  suspendedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events         Event[]
  createdRooms   MatchingRoom[]    @relation("RoomCreator")
  participations RoomParticipant[]
  createdMeetups Meetup[]
  meetupJoins    MeetupParticipant[]
  feedPosts      FeedPost[]
  feedPostLikes    FeedPostLike[]
  feedPostSaves    FeedPostSave[]
  placeSaves       PlaceSave[]
  feedPostComments FeedPostComment[]
  reportsMade      Report[]
  meetupReviews    MeetupReview[]
  timeProposalVotes TimeProposalVote[]
  locationSuggestVotes LocationSuggestVote[]
  invitePolls          InvitePoll[]
  inviteResponses      InviteResponse[]
  friendSettingsGiven    FriendSettings[] @relation("SettingsOwner")
  friendSettingsReceived FriendSettings[] @relation("SettingsFriend")
  friendGroups     FriendGroup[]       @relation("GroupOwner")
  groupMemberships FriendGroupMember[] @relation("GroupMemberOf")
  savedLocations   SavedLocation[]
  locationRecommendRequestsMade LocationRecommendRequest[]
  locationRecommendResponses    LocationRecommendResponse[]
  settings       UserSettings?
  pushTokens     PushToken[]
  activeDays     UserActiveDay[]
  analyticsEvents AnalyticsEvent[]
  engagement     UserEngagement?
  blockedUsers   Block[] @relation("Blocker")
  blockedByUsers Block[] @relation("Blocked")

  sentFriendRequests     FriendRequest[] @relation("SentRequests")
  receivedFriendRequests FriendRequest[] @relation("ReceivedRequests")

  chatRoomMemberships ChatRoomMember[]
  sentMessages        Message[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  adminActionLogs     AdminActionLog[]

  @@map("users")
}

// ------------------------------------------------------------
// RefreshToken (로그인 유지용 - 액세스 토큰이 만료되면 이걸로 재발급)
// ------------------------------------------------------------
model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// 비밀번호 재설정 링크 - 이메일로 받은 원본 토큰은 여기 저장 안 하고, 해시만 저장함(유출돼도 재사용 불가)
model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ------------------------------------------------------------
// FriendRequest (친구 요청 - 수락되면 곧 친구 관계가 됨)
// ------------------------------------------------------------
enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model FriendRequest {
  id          String              @id @default(uuid())
  senderId    String
  sender      User                @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    User                @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  respondedAt DateTime?

  // 같은 두 사람 사이에 중복 요청이 쌓이지 않도록
  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@map("friend_requests")
}

// ------------------------------------------------------------
// Chat (1:1 / 그룹 채팅방, 메시지, 예약 요청)
// ------------------------------------------------------------
enum MessageType {
  TEXT
  RESERVATION
  TIME_PROPOSAL
  LOCATION_SUGGEST
  LOCATION_NOTICE // 채팅방에 고정된 장소(PinnedItem)가 등록/변경됐을 때 상대방에게 알려주는 일방향 알림 메시지
  LOCATION_RECOMMEND // 다중 모임 자동 장소 추천 - 참가자 출발지 기반, 결과만 그룹에 공유(개인 출발지는 비공개)
  IMAGE
}

enum LocationRecommendMode {
  FAIR       // 공평하게 - 참가자 간 이동시간 차이 최소화
  FASTEST    // 가장 빠르게 - 전체 평균 이동시간 최소화
  CONSIDERATE // 먼 사람 배려 - 가장 오래 걸리는 사람의 이동시간 최소화
}

enum LocationRecommendStatus {
  COLLECTING // 참가자들의 출발지 제출을 기다리는 중
  COMPLETED  // 계산 완료, 결과 메시지가 그룹에 게시됨
  CANCELLED  // 요청자가 취소함
}

enum ProposalStatus {
  VOTING
  CONFIRMED
  CANCELLED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  DECLINED
  WITHDRAWN // 보낸 사람이 대기중인 요청을 스스로 취소
  CANCELLED // 확정됐던 예약을 나중에 취소
  SUPERSEDED // LOCATION_NOTICE 전용: 장소가 다시 바뀌어서, 이 알림은 이제 예전 알림이 됐다는 표시 (작은 알림으로만 표시됨)
}

model ChatRoom {
  id        String   @id @default(uuid())
  isGroup   Boolean  @default(false)
  name      String? // 그룹방 이름. 1:1 채팅은 null이고 프론트에서 상대방 이름을 사용
  createdAt DateTime @default(now())

  members  ChatRoomMember[]
  messages Message[]
  pinnedItems PinnedItem[]
  meetup   Meetup?
  locationRecommendRequests LocationRecommendRequest[]

  @@map("chat_rooms")
}

model ChatRoomMember {
  id         String   @id @default(uuid())
  chatRoomId String
  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt   DateTime @default(now())
  lastReadAt DateTime @default(now()) // 이 멤버가 이 방을 마지막으로 읽은 시각 (이후 도착 메시지가 "안읽음")
  muted      Boolean  @default(false) // 이 방의 알림(토스트)만 끔 - 안읽음 표시는 그대로 유지됨

  @@unique([chatRoomId, userId])
  @@map("chat_room_members")
}

model Message {
  id         String      @id @default(uuid())
  chatRoomId String
  chatRoom   ChatRoom    @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  type       MessageType @default(TEXT)
  createdAt  DateTime    @default(now())

  // TEXT 메시지일 때
  text String?
  // 답장(다른 메시지를 인용)일 때 - 관계 대신 단순 참조로 둬서, 원본이 지워져도 이 메시지 자체는 안전함.
  // 미리보기는 보낼 때 스냅샷으로 같이 저장해서, 원본이 삭제돼도(또는 아직 안 불러왔어도) 바로 보여줄 수 있게 함
  replyToMessageId String?
  replyToPreview   String?

  // RESERVATION 메시지일 때 (캘린더 매칭에서 이어지는 예약 요청)
  reservationStart  DateTime?
  reservationEnd    DateTime?
  reservationNote   String?
  reservationLocation    String?
  reservationLocationLat Float?
  reservationLocationLon Float?
  reservationStatus ReservationStatus?

  // LOCATION_SUGGEST 메시지일 때 (핫플레이스를 장소로 제안하고 수락/거절)
  locationPlace   String?
  locationNote    String?
  locationAddress String?
  locationLat     Float?
  locationLon     Float?
  locationStatus  ReservationStatus? // 같은 상태값(PENDING/CONFIRMED/DECLINED/WITHDRAWN/CANCELLED)을 재사용
  locationPlaceId String? // 이 장소가 캐치미 장소 DB(Place)의 어느 곳인지 (LOCATION_SUGGEST / LOCATION_NOTICE)
  locationVotes   LocationSuggestVote[] // 장소 후보 투표 (한 방에서 한 사람은 대기 중인 후보 하나에만 투표)
  locationPinId   String? // 이 장소 제안이 어느 약속(PinnedItem)을 위한 건지 - 비어 있으면 아직 날짜 미정 약속

  // IMAGE 메시지일 때 - 사진을 base64로 DB에 직접 저장 (프로필 사진과 같은 방식)
  imageUrl String?

  // TIME_PROPOSAL 메시지일 때 (그룹에 여러 시간 후보를 제안하고 투표)
  proposalStatus ProposalStatus?
  proposalOptions TimeProposalOption[]

  // LOCATION_RECOMMEND 메시지일 때 (다중 모임 자동 장소 추천 결과 - 참가자 개별 출발지/개별 이동시간은
  // 절대 포함하지 않고, 추천된 동네/지역과 전체 평균·최장 이동시간 같은 집계값만 담음)
  recommendRequestId    String?                @unique
  recommendRequest      LocationRecommendRequest? @relation(fields: [recommendRequestId], references: [id])
  recommendAreaName     String? // 추천된 동네/지역 이름 (예: "강남역 부근")
  recommendLat          Float?
  recommendLon          Float?
  recommendMode         LocationRecommendMode?
  recommendAvgMinutes   Int?
  recommendMaxMinutes   Int?
  recommendParticipants Int? // 계산에 참여한 인원 수

  @@index([chatRoomId, createdAt])
  @@index([locationPlaceId])
  @@map("messages")
}

// ------------------------------------------------------------
// LocationRecommendRequest (다중 모임 자동 장소 추천 - 요청 한 건)
// 참가자별 출발지(LocationRecommendResponse)는 이 요청에 딸려서 비공개로만 보관되고,
// 계산이 끝나면 집계 결과만 Message(LOCATION_RECOMMEND)로 그룹에 공개됨
// ------------------------------------------------------------
model LocationRecommendRequest {
  id          String                    @id @default(uuid())
  chatRoomId  String
  chatRoom    ChatRoom                  @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  requesterId String
  requester   User                      @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  mode        LocationRecommendMode
  status      LocationRecommendStatus  @default(COLLECTING)
  createdAt   DateTime                  @default(now())
  completedAt DateTime?

  responses   LocationRecommendResponse[]
  resultMessage Message?

  @@index([chatRoomId])
  @@map("location_recommend_requests")
}

// 참가자 한 명이 제출한 출발지 - 서버 계산에만 쓰이고, API 응답/다른 유저에게는 절대 노출되지 않음
model LocationRecommendResponse {
  id          String                   @id @default(uuid())
  requestId   String
  request     LocationRecommendRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId      String
  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address     String
  lat         Float
  lon         Float
  submittedAt DateTime                 @default(now())

  @@unique([requestId, userId])
  @@map("location_recommend_responses")
}

// 시간 제안 메시지 하나에 딸린 시간 후보 하나
model TimeProposalOption {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  startTime DateTime
  endTime   DateTime
  votes     TimeProposalVote[]

  @@map("time_proposal_options")
}

// 어떤 후보에 누가 투표했는지 (한 사람은 한 후보에만 투표, 바꾸면 기존 투표는 지워짐)
model TimeProposalVote {
  id        String   @id @default(uuid())
  optionId  String
  option    TimeProposalOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([optionId, userId])
  @@map("time_proposal_votes")
}

// 장소 제안(LOCATION_SUGGEST) 후보에 누가 투표했는지 - 한 방에서 한 사람은 대기 중인 후보 하나에만 투표
// (다른 후보에 투표하면 기존 투표는 지워짐). 모두 투표해서 1등이 하나로 갈리면 그 장소로 자동 확정
model LocationSuggestVote {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@map("location_suggest_votes")
}

// ------------------------------------------------------------
// InvitePoll (약속 초대 링크) - 만든 사람이 날짜/시간 범위를 정해서 링크를 보내면,
// 받은 사람은 회원가입 없이 이름만 적고 가능한 시간(1시간 칸)을 골라 제출함.
// 만든 사람이 시간을 확정하면 그때부터 링크 페이지에서 CATCHME 가입을 권함.
// ------------------------------------------------------------
enum InviteStatus {
  OPEN
  CONFIRMED
  CANCELLED
}

model InvitePoll {
  id             String       @id @default(uuid())
  token          String       @unique // 링크에 들어가는 추측 불가능한 값 (?invite=token)
  creatorId      String
  creator        User         @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title          String
  dates          String[] // 후보 날짜들 "YYYY-MM-DD" (한국 시간 기준)
  startHour      Int // 하루 중 고를 수 있는 시작 시각 (0~23)
  endHour        Int // 끝 시각 (1~24, 이 시각 직전 칸까지)
  fromCalendar   Boolean      @default(false) // true면 만든 사람 캘린더의 "예약 가능" 시간 칸만 고를 수 있음 (캘린더가 바뀌면 바로 반영)
  manualCells    String[]     @default([]) // 직접 고르기 링크에서 날짜마다 따로 연 1시간 칸 "YYYY-MM-DD|HH" - 링크에만 저장 (비어 있으면 startHour~endHour 전부)
  audience       String       @default("friends") // "friends" | "work" - 캘린더 기준 링크에서 어떤 예약 가능 시간을 보여줄지 (모두 + 친구만 / 모두 + 일만)
  // 추천 게시물 등에서 "약속 장소로 선택"해서 만든 링크면 장소가 같이 붙음 (없으면 null)
  placeName      String?
  placeAddress   String?
  placeLat       Float?
  placeLon       Float?
  status         InviteStatus @default(OPEN)
  confirmedStart DateTime?
  confirmedEnd   DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  responses InviteResponse[]

  @@index([creatorId])
  @@map("invite_polls")
}

// 링크로 들어온 사람 한 명의 응답 - 비회원은 브라우저에 저장한 guestKey로 자기 응답을 다시 고칠 수 있음
model InviteResponse {
  id        String     @id @default(uuid())
  pollId    String
  poll      InvitePoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  guestKey  String
  name      String
  userId    String? // 로그인한 상태로 응답했거나, 나중에 가입해서 연결한 경우
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  cells     String[] // 가능한 1시간 칸들 "YYYY-MM-DD|HH"
  ranges    String[]   @default([]) // 분 단위로 맞춘 가능 시간 "YYYY-MM-DD|HH:MM|HH:MM" (cells의 이어진 칸 묶음마다 하나, 없으면 칸 그대로)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([pollId, guestKey])
  @@map("invite_responses")
}

// ------------------------------------------------------------
// Event (개인 일정 - Title은 Private)
// ------------------------------------------------------------
model Event {
  id        String             @id @default(uuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  startTime DateTime
  endTime   DateTime
  title     String // ⚠️ Private: 다른 유저/응답에 절대 노출 금지
  status    AvailabilityStatus @default(BUSY)
  eventType String             @default("busy") // "busy" | "available"
  // 예약 가능 일정을 누구에게 열지 - "all"(모두) | "friends"(친구만: 앱 친구에게만) | "work"(일만: 일용 초대 링크로만)
  availableFor String         @default("all")

  // 공개 설정 - 친구 캘린더 보기/매칭에서 이 일정이 "바쁨/가능"으로 노출될지 여부
  // visiblePrivate=true면 나만보기(friend_settings.privateAccess로 예외 허용된 사람만 봄).
  // 그게 아니고 visibleGroupIds가 비어있지 않으면, 그 그룹(들)에 속한 친구에게만 공개.
  // 그것도 아니면(나만보기X, 그룹 지정 없음) 모든 친구에게 공개.
  visiblePrivate  Boolean  @default(false)
  visibleGroupIds String[] @default([])

  // 바쁨 일정이 예약을 막는지 - false면 내 캘린더엔 그대로 있지만 이 시간에도 예약 가능 시간을 열 수 있고,
  // 친구/초대 링크 쪽에선 이 일정이 없는 것처럼 취급함 ("이 시간에도 예약 받기")
  blocksBooking Boolean @default(true)

  // 예약 요청을 보냈지만 아직 상대가 수락/거절하지 않은 "예약중..." 상태 표시용
  // (상대가 응답하면 이 일정은 지워지고, 확정이면 정식 약속 일정이 새로 생김)
  isPendingHold     Boolean @default(false)
  sourceMessageId   String? // 이 일정을 만든 예약/채팅 메시지 id - 확정된 약속이면 채팅으로 바로 이동할 때, 홀드면 응답 왔을 때 찾는 용도
  sourceChatRoomId  String? // sourceMessageId가 있는 채팅방 id - "채팅에서 확인" 버튼에서 바로 그 방을 열 때 씀

  // 매주 반복 일정용 - 요일 반복(0=일 ~ 6=토)이 있으면 이 일정은 반복 일정임.
  // startTime/endTime은 "첫 번째 발생일"의 날짜+시간을 나타내고(반복 시작 기준일 + 매일 적용될 시간),
  // recurringUntil이 있으면 그 날짜까지만, 없으면 계속 반복됨. 특정 날짜만 빼고 싶으면 recurringExceptions에 그 날짜를 담음.
  recurringWeekdays   Int[]     @default([])
  recurringUntil      DateTime?
  recurringExceptions String[]  @default([]) // "YYYY-MM-DD" 형식 - 이 날짜들은 반복에서 제외됨

  // 내 캘린더(한달/일주일 보기)에서 이 일정 블록에 쓸 색 ("#RRGGBB"). null이면 테마 기본 색을 씀.
  // 본인 화면 표시용이라 친구 캘린더 등 다른 유저 응답에는 내보내지 않음
  color String?

  // 이동시간 (설정에서 켠 사람만 씀) - 목적지/출발지 이름·좌표와 카카오 대중교통으로 구한 이동시간(분).
  // 내 캘린더에서 일정 바로 앞에 "이동시간" 칸으로 보여줌. 본인 화면용이라 친구 쪽 응답엔 내보내지 않음
  travelMinutes  Int?
  travelToName   String?
  travelToLat    Float?
  travelToLon    Float?
  travelFromName String?
  travelFromLat  Float?
  travelFromLon  Float?

  // 일정 메모·장소 - 본인 화면용이라 친구 쪽 응답엔 내보내지 않음. 장소 좌표는 지도로 열 때 씀
  note         String?
  placeName    String?
  placeAddress String?
  placeLat     Float?
  placeLon     Float?

  createdAt DateTime @default(now())

  @@index([userId, startTime, endTime])
  @@index([sourceMessageId])
  @@map("events")
}

// ------------------------------------------------------------
// PinnedItem (채팅방에 고정해둔 확정 일정/장소)
// ------------------------------------------------------------
model PinnedItem {
  id              String   @id @default(uuid())
  chatRoomId      String
  chatRoom        ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  dateLabel       String?
  timeLabel       String?
  note            String?
  location        String?
  locationAddress String? // 장소의 주소 (상단 고정 카드에 장소 이름 아래 같이 보여줌)
  locationLat     Float?
  locationLon     Float?
  sourceMessageId String?
  forPinId        String? // 장소만 있는 핀일 때 어느 약속(PinnedItem)의 장소인지 - 비어 있으면 날짜 미정 약속 / 예전 데이터
  createdAt       DateTime @default(now())

  @@index([chatRoomId])
  @@map("pinned_items")
}

// ------------------------------------------------------------
// FriendSettings (이 친구 한 명에 대한 내 기준 개별 설정 - 지금은 privateAccess 하나뿐)
// ------------------------------------------------------------
model FriendSettings {
  id       String @id @default(uuid())
  ownerId  String
  owner    User   @relation("SettingsOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  friendId String
  friend   User   @relation("SettingsFriend", fields: [friendId], references: [id], onDelete: Cascade)

  // true면: owner가 "나만보기"로 표시해둔 일정도 이 friend한테는 그대로 보임 (예: 연인 등 특별히 더 공개하고 싶은 특정 친구 한 명/몇 명을 지정)
  privateAccess Boolean @default(false)

  @@unique([ownerId, friendId])
  @@map("friend_settings")
}

// ------------------------------------------------------------
// FriendGroup (인스타 "친한 친구"처럼, 내가 직접 이름 붙여 만드는 친구 그룹 - 일정 공개 대상으로 씀)
// ------------------------------------------------------------
model FriendGroup {
  id        String   @id @default(uuid())
  ownerId   String
  owner     User     @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  emoji     String? // 캘린더/공개 범위 칩에 붙는 이모티콘 (없으면 앱에서 👥)
  createdAt DateTime @default(now())

  members FriendGroupMember[]

  @@index([ownerId])
  @@map("friend_groups")
}

// 그룹에 속한 친구 한 명 (한 친구가 여러 그룹에 동시에 속할 수 있음)
model FriendGroupMember {
  id       String      @id @default(uuid())
  groupId  String
  group    FriendGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  friendId String
  friend   User        @relation("GroupMemberOf", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([groupId, friendId])
  @@map("friend_group_members")
}

// ------------------------------------------------------------
// SavedLocation (내 정보에 저장해두는 자주 쓰는 출발지 - 집/회사/학교/직접입력)
// 그룹 채팅방에서 "모임 장소 추천"을 받을 때 매번 주소를 새로 검색하지 않고
// 바로 골라서 쓸 수 있게 함. HOME/WORK/SCHOOL은 유저당 하나씩만(저장할 때 upsert),
// CUSTOM은 여러 개 저장 가능(앱단에서 개수 제한).
// ------------------------------------------------------------
model SavedLocation {
  id          String             @id @default(uuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       SavedLocationLabel @default(CUSTOM)
  customLabel String? // label이 CUSTOM일 때 사용자가 직접 붙인 이름 (예: "본가", "헬스장")
  address     String // 화면에 보여줄 주소 텍스트
  lat         Float
  lon         Float
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([userId])
  @@map("saved_locations")
}

enum SavedLocationLabel {
  HOME
  WORK
  SCHOOL
  CUSTOM
}

// ------------------------------------------------------------
// FeedPost (커뮤니티 소식 - 밥집/카페/액티비티 추천 글)
// ------------------------------------------------------------
// 장소 - 캐치미 자체 장소 DB. 사용자가 실제로 제안/확정/리뷰한 가게만 여기에 등록됨
// (카카오 장소 정보를 대량으로 쌓지 않음 - 카카오 id는 같은 가게를 알아보는 참조용으로만 저장)
// 같은 가게 판별: kakaoPlaceId가 같거나, normName(띄어쓰기/대소문자 무시한 이름)이 같고 100m 안이면 같은 곳
model Place {
  id             String    @id @default(uuid())
  name           String // 상호명 (예: "빽다방 잠실새내점")
  normName       String    @default("") // 같은 가게 찾기용 이름 (공백/기호 제거, 소문자)
  category       String // "food" | "cafe" | "experience" | "etc"
  categoryDetail String? // 세부 업종 (예: "돈까스,우동")
  location       String? // 동네/역 이름 등 사람이 보는 대략적 위치명
  address        String? // 도로명/지번 주소
  phone          String?
  lat            Float?
  lon            Float?
  kakaoPlaceId   String?   @unique // 카카오 장소 id (참조용)
  source         String    @default("user") // "user"(사용자 입력) | "kakao"(카카오 검색에서 고름) | "public"(공공데이터)
  isSponsored    Boolean   @default(false) // 광고비를 낸 곳 - 목록 맨 위에 노출됨
  sponsoredUntil DateTime? // 광고 노출 종료 시점 (지나면 자동으로 일반 노출로)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  reviews FeedPost[]
  events  PlaceEvent[]
  saves   PlaceSave[]

  @@index([normName])
  @@map("places")
}

// 장소 행동 기록 - 어느 가게가 약속 장소로 제안/확정/리뷰됐는지 (인기 순위, 광고 효과 측정의 기반)
model PlaceEvent {
  id         String   @id @default(uuid())
  placeId    String
  place      Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  type       String // "SUGGEST" | "CONFIRM" | "REVIEW"
  userId     String?
  chatRoomId String?
  messageId  String?
  postId     String?
  createdAt  DateTime @default(now())

  @@index([placeId, type])
  @@index([createdAt])
  @@map("place_events")
}

// 장소 저장(⭐ 나중에 가볼 곳) - 리뷰가 아니라 장소를 저장함. 한 사람이 한 장소를 한 번만, 다시 누르면 저장 취소
model PlaceSave {
  id        String   @id @default(uuid())
  placeId   String
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([placeId, userId])
  @@index([userId])
  @@map("place_saves")
}

// 소식 게시물 - 각자 올린 글이 독립적인 하나의 게시물로 따로 보임 (더 이상 같은 장소끼리 묶지 않음)
model FeedPost {
  id        String   @id @default(uuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  placeId   String? // 이 리뷰가 어느 장소(Place)에 대한 것인지 - 같은 가게 리뷰를 이름이 달라도 하나로 모음
  place     Place?   @relation(fields: [placeId], references: [id], onDelete: SetNull) // 장소가 지워져도 리뷰는 남김
  category  String? // "food" | "cafe" | "experience" - 게시물 자체에 직접 저장함
  title     String? // 제목 (상호명 등) - 게시물 자체에 직접 저장함
  location  String? // 동네/역 이름 등
  address   String? // 실제 도로명/지번 주소 (장소 검색으로 골랐을 때 자동 저장됨)
  phone     String? // 가게 전화번호 (장소 검색 결과에 있으면 자동 저장됨)
  lat       Float?
  lon       Float?
  note      String?
  rating    Int? // 1~5점 별점 (선택)
  photos    String[] @default([]) // base64 이미지 문자열 배열 (1~5장, 장당 대략 500KB 이하)
  tags      String[] @default([]) // 약속 후 후기에서 고른 항목들 ("talk" | "group" | "price" | "revisit")
  fromMeetup Boolean @default(false) // 채팅방 약속이 끝난 뒤 "오늘 여기서 만나보니 어땠어요?"로 남긴 후기
  createdAt DateTime @default(now())

  likes    FeedPostLike[]
  saves    FeedPostSave[]
  comments FeedPostComment[]

  @@map("feed_posts")
}

// 리뷰 좋아요 - 한 사람이 한 리뷰에 좋아요는 한 번만 누를 수 있음
model FeedPostLike {
  id        String   @id @default(uuid())
  postId    String
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@map("feed_post_likes")
}

// 예전 리뷰 저장 - 이제는 PlaceSave(장소 저장)를 씀. 기존 기록은 place_saves로 옮겨둠
model FeedPostSave {
  id        String   @id @default(uuid())
  postId    String
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId])
  @@map("feed_post_saves")
}

// 리뷰 댓글
model FeedPostComment {
  id        String   @id @default(uuid())
  postId    String
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text      String
  rating    Int? // 댓글에도 선택적으로 1~5점 별점을 달 수 있음 (원글 작성자가 아니어도 자기 의견을 별점으로 남길 수 있게)
  createdAt DateTime @default(now())

  @@map("feed_post_comments")
}

// ------------------------------------------------------------
// Meetup (커뮤니티 - 모임)
// ------------------------------------------------------------
model Meetup {
  id          String   @id @default(uuid())
  creatorId   String
  creator     User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title       String
  category    String // "food" | "cafe" | "experience" 등
  location    String?
  lat         Float?
  lon         Float?
  dateLabel   String?
  timeLabel   String?
  eventDate   DateTime? // 실제 모임 일시 (지난 모임 자동 숨김 판단에 사용)
  description String?
  maxParticipants Int  @default(6)
  cancelled   Boolean  @default(false) // 만든 사람이 취소한 모임 - 목록엔 안 보이지만 기존 채팅방은 유지됨
  chatRoomId  String?  @unique // 이 모임 전용 진짜 그룹 채팅방
  chatRoom    ChatRoom? @relation(fields: [chatRoomId], references: [id])
  createdAt   DateTime @default(now())

  participants MeetupParticipant[]
  reviews      MeetupReview[]

  @@map("meetups")
}

// 모임 후기 - 모임이 끝난 뒤 참여자가 남기는 평점/한줄평 (개인이 아닌 모임 경험 자체에 대한 평가)
model MeetupReview {
  id        String   @id @default(uuid())
  meetupId  String
  meetup    Meetup   @relation(fields: [meetupId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  rating    Int // 1~5점
  note      String?
  createdAt DateTime @default(now())

  @@unique([meetupId, authorId])
  @@map("meetup_reviews")
}

model MeetupParticipant {
  id       String   @id @default(uuid())
  meetupId String
  meetup   Meetup   @relation(fields: [meetupId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status   String   @default("APPROVED") // "PENDING"(방장 수락 대기중) | "APPROVED"(정식 참여) | "DECLINED"(거절됨) - 모임장은 만들 때 자동 APPROVED
  intro    String? // 신청할 때 남긴 자기소개 - 방장이 수락 여부 판단할 때 참고
  joinedAt DateTime @default(now())

  @@unique([meetupId, userId])
  @@map("meetup_participants")
}

// ------------------------------------------------------------
// UserSettings (설정 화면에서 바꾸는 모든 값 - 기기/새로고침과 무관하게 유지)
// ------------------------------------------------------------
model UserSettings {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  darkMode            Boolean @default(false)
  defaultScheduleView String  @default("month") // "day" | "week" | "month"

  privCalendarPublic Boolean @default(false) // 켜면 친구 캘린더에 일정 "제목"까지 노출
  privStrangerChat   Boolean @default(true) // 끄면 친구만 나에게 새 1:1 채팅을 시작할 수 있음

  notifMessage   Boolean @default(true)
  notifFriendreq Boolean @default(true)
  notifMatched   Boolean @default(true)
  notifMarketing Boolean @default(false)

  friendAutoaccept  Boolean @default(false) // 켜면 받은 친구 요청이 즉시 자동 수락됨
  friendSearchAllow Boolean @default(true) // 끄면 아이디 검색 결과에서 내가 제외됨

  chatReadReceipt Boolean @default(true)
  chatPreview     Boolean @default(true)

  workEmoji String @default("💼") // 업무용 링크에 연 시간에 붙는 이모티콘
  colorLabels String[] @default([]) // 일정 색 라벨 10개 이름 (빈칸 = 기본 이름)

  updatedAt DateTime @updatedAt

  @@map("user_settings")
}

// ------------------------------------------------------------
// Block (차단 - 차단하면 친구요청/채팅을 서로 못 함)
// ------------------------------------------------------------
model Block {
  id        String   @id @default(uuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@map("blocks")
}

// 신고 - 리뷰, 모임, 사용자 등 여러 대상을 신고할 수 있는 범용 모델.
// 지금은 자동으로 뭔가 처리되진 않고 기록만 남김 (나중에 관리자 화면에서 검토하는 걸 전제로 함)
model Report {
  id         String   @id @default(uuid())
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  targetType String // "FEED_POST" | "MEETUP" | "USER"
  targetId   String
  reason     String
  detail     String?
  images     String[] @default([]) // 오류 신고(BUG)에 첨부한 사진 - base64 data URL, 최대 3장
  status     String   @default("PENDING") // "PENDING" | "REVIEWED" | "DISMISSED"
  createdAt  DateTime @default(now())

  @@map("reports")
}

// 관리자 행동 기록 - 누가(actor) 언제 어떤 조치를(유저 정지/삭제, 게시물 삭제, 모임 취소, 신고 처리 등)
// 했는지 남겨두는 감사 로그. 지금은 관리자가 혼자라 당장 급하진 않지만, 나중에 "내가 왜 이걸 정지시켰지"
// 확인하거나 관리자가 여러 명이 될 때를 대비해 처음부터 남겨둠.
model AdminActionLog {
  id         String   @id @default(uuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action     String // "SUSPEND_USER" | "UNSUSPEND_USER" | "DELETE_USER" | "DELETE_FEED_POST" | "CANCEL_MEETUP" | "RESOLVE_REPORT" 등
  targetType String? // "USER" | "FEED_POST" | "MEETUP" | "REPORT"
  targetId   String?
  detail     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@map("admin_action_logs")
}

// ------------------------------------------------------------
// MatchingRoom (약속 방)
// ------------------------------------------------------------
model MatchingRoom {
  id         String   @id @default(uuid())
  creatorId  String
  creator    User     @relation("RoomCreator", fields: [creatorId], references: [id])
  title      String
  rangeStart DateTime
  rangeEnd   DateTime
  shareLink  String   @unique @default(cuid())
  createdAt  DateTime @default(now())

  participants RoomParticipant[]

  @@map("matching_rooms")
}

// ------------------------------------------------------------
// RoomParticipant (방 참여자 - 회원/비회원 모두 지원)
// ------------------------------------------------------------
model RoomParticipant {
  id     String       @id @default(uuid())
  roomId String
  room   MatchingRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  userId        String?
  user          User?   @relation(fields: [userId], references: [id])
  guestNickname String?

  joinedAt DateTime @default(now())

  @@unique([roomId, userId])
  @@map("room_participants")
}

// 휴대폰 푸시 알림(FCM)용 기기 토큰. 한 사용자가 여러 기기를 쓸 수 있음
model PushToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  String   @default("android")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("push_tokens")
}

// ------------------------------------------------------------
// 사용 지표 (활성화/재방문 측정용) - 관리자 페이지 "지표" 탭에서 봄
// ------------------------------------------------------------

// 하루에 한 번이라도 앱을 쓴 날 (한국 날짜 "YYYY-MM-DD"). D1/D7 재방문율 계산용
model UserActiveDay {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  day    String

  @@id([userId, day])
  @@index([day])
  @@map("user_active_days")
}

// 주요 행동 기록 (signup, first_event, calendar_import, invite_created, invite_responded, push_open 등)
model AnalyticsEvent {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  props     Json?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([userId, name])
  @@map("analytics_events")
}

// 정기 알림(아침 오늘 일정, 일요일 저녁 다음 주 시간 열기) 받을지 + 마지막으로 보낸 날
// (같은 날 두 번 안 보내게 - 서버가 재시작되거나 여러 대여도 여기 기록으로 막음)
model UserEngagement {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  morningBrief  Boolean  @default(true)
  weeklyNudge   Boolean  @default(true)
  lastMorningOn String?
  lastWeeklyOn  String?
  updatedAt     DateTime @updatedAt

  @@map("user_engagement")
}
